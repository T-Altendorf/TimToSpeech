# Cache directory for storing generated audio files
# This path is inside the container
CACHE_DIR=/app/cache

# Port inside the container (default: 8000)
PORT=8000

# Port exposed on the host machine for local development (default: 8000)
# For production deployments (Dokploy/K8s), only set PORT - the orchestrator handles external mapping
HOST_PORT=8000

# Maximum time in seconds to wait for TTS generation before returning a job ID for polling
# Default: 7.0 seconds
TTS_WAIT_TIMEOUT=7.0

# Allowed CORS origins for browser clients (e.g. Expo web on http://localhost:8081)
# Comma-separated list, or "*" to allow any origin (default: *)
CORS_ORIGINS=*

# Kurdish TTS API key (https://www.kurdishtts.com/docs/api)
# Only required for sentences longer than 150 characters - anything within that
# limit uses the free endpoint. Leave unset to run free-tier only.
KURDISH_TTS_API_KEY=

KURDISH_TTS_API_KEY=...